# Copy to .env (never commit .env). Everything is optional: the app runs without any of these.

# Tiger Data (Timescale Cloud) or any PostgreSQL connection string. Leave empty for local SQLite demo mode.
DATABASE_URL=
# TIGER_DATABASE_URL=   # alternative name, takes priority over DATABASE_URL

# Google Gemini API key (https://aistudio.google.com/apikey). Leave empty to use deterministic local explanations.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# "auto" (default): use Tiger Data / Gemini whenever credentials exist.  "true": force local SQLite + local explanations.
DEMO_MODE=auto
